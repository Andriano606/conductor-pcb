{
  "name": "conductor-pcb",
  "version": "0.1.0",
  "description": "Conductor PCB: проекти KiCad, чат з Claude, який перевіряє й виправляє плату, і бібліотека правил трасування",
  "main": "./out/main/index.js",
  "author": {
    "name": "andrii",
    "email": "andrii.kuluiev@partingpro.com"
  },
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev -- --no-sandbox",
    "build": "electron-vite build",
    "start": "electron-vite preview -- --no-sandbox",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "dist": "electron-vite build && electron-builder --linux",
    "postdist": "bash scripts/install-desktop.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate-rules": "node scripts/validate-rules.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "31.7.7",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.3.5",
    "vitest": "^2.1.9"
  },
  "homepage": "https://github.com/andrii/conductor-pcb"
}
